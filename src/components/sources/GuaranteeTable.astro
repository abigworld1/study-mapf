---
import { getAlgorithm, type AlgorithmEntry } from "@/lib/manifest";

/**
 * 理論保証を共通形式で表示する。
 *
 * ★ 値は algorithms.yaml からのみ取る。ページ側で上書きさせない。
 *   原論文で確認できていないものは「不明」と出す。もっともらしい値を埋めない
 *   （SOURCE_POLICY.md 第 7 条）。
 *
 * ★ 「最適」と「eventually optimal」を混同しない（第 8 条）。
 *   conditional の中身は guarantee_evidence に原文で書いてある。
 */
interface Props {
  algorithmId: string;
  /** 対象問題。ページ側で補足したい場合に渡す。 */
  problemLabel?: string;
}

const { algorithmId, problemLabel } = Astro.props;
const algo = getAlgorithm(algorithmId);

/*
  ★ 「方式」は原論文が自ら述べている場合だけ出す。
    以前はページ側から渡す prop にしていたが、渡し忘れると全ページが
    「方式: 不明」という無意味な行を表示していた。値の出どころを
    algorithms.yaml に一本化し、未確認なら行ごと省く。
    書くなら architecture_evidence が必須（validate-sources.mjs が検査する）。
*/
const ARCHITECTURE_LABEL: Record<string, string> = {
  centralized: "集中型",
  decentralized: "分散型",
  "decentralized-capable": "分散実装に向く（論文の主張は適性であって分散型そのものではない）",
};
const architectureLabel = algo?.architecture ? ARCHITECTURE_LABEL[algo.architecture] : undefined;

const COMPLETE_LABEL: Record<string, string> = {
  true: "あり",
  false: "なし",
  conditional: "条件付き",
  unknown: "不明",
};

function optimalLabel(entry: AlgorithmEntry): string {
  const { optimal, bounded_suboptimal: bounded } = entry.guarantees;
  if (optimal === true) return "最適";
  if (bounded === true) return "bounded-suboptimal";
  if (optimal === "conditional") return "条件付き（eventually optimal 等。根拠欄を参照）";
  if (optimal === false && bounded === false) return "なし";
  return "不明";
}

const problemTypes = algo?.problem_types ?? [];
const PROBLEM_LABEL: Record<string, string> = {
  "single-agent": "single-agent",
  "classical-mapf": "one-shot MAPF",
  "continuous-time-mapf": "continuous-time MAPF",
  "lifelong-mapf": "lifelong MAPF",
  mapd: "MAPD",
  tapf: "TAPF",
  assignment: "割当問題",
  flow: "ネットワークフロー",
  benchmark: "ベンチマーク",
};
---

{
  !algo ? (
    <p class="guarantee-missing">
      algorithms.yaml に <code>{algorithmId}</code> がありません。
    </p>
  ) : (
    <div class="guarantee">
      <div class="table-scroll">
        <table>
          <caption>
            理論保証。<strong>原論文で確認できた記述だけ</strong>を載せています。
            「不明」は「保証が無い」ではなく「原論文で未確認」の意味です。
          </caption>
          <tbody>
            <tr>
              <th scope="row">完全性</th>
              <td>
                <span class={`badge badge-${String(algo.guarantees.complete)}`}>
                  {COMPLETE_LABEL[String(algo.guarantees.complete)] ?? "不明"}
                </span>
              </td>
            </tr>
            <tr>
              <th scope="row">最適性</th>
              <td>
                <span class={`badge badge-${String(algo.guarantees.optimal)}`}>
                  {optimalLabel(algo)}
                </span>
              </td>
            </tr>
            <tr>
              <th scope="row">対象</th>
              <td>
                {problemLabel ??
                  (problemTypes.length > 0
                    ? problemTypes.map((t) => PROBLEM_LABEL[t] ?? t).join(" / ")
                    : "不明")}
              </td>
            </tr>
            {architectureLabel && (
              <tr>
                <th scope="row">方式</th>
                <td>{architectureLabel}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      {/*
        ★ notes は「保証が及ぶ範囲」の但し書きを持つことが多いので必ず出す。
          例: SIPP の Theorem 1/2 は単一エージェント問題の保証であって、
          固定優先順位の MAPF ラッパーには及ばない。
          これを隠すと表の「完全性: あり / 最適性: 最適」だけが読まれ、
          過大な主張として伝わる（SOURCE_POLICY.md 第 8 条）。
      */}
      {algo.notes && (
        <p class="caveat">
          <strong>適用範囲の注意:</strong> {algo.notes}
        </p>
      )}

      {algo.guarantee_evidence ? (
        <details class="evidence">
          <summary>保証の根拠（原論文の記述）</summary>
          <p>{algo.guarantee_evidence}</p>
          {algo.architecture_evidence && <p>{algo.architecture_evidence}</p>}
        </details>
      ) : (
        <p class="no-evidence">
          この手法の保証は、原論文の該当箇所をまだ確認できていません。
          確認が済むまで「不明」のままにしています。
        </p>
      )}
    </div>
  )
}

<style>
  .guarantee {
    margin-block: var(--space-4);
  }
  .badge {
    display: inline-block;
    padding: 0.1em 0.6em;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 700;
    border: 1px solid transparent;
  }
  .badge-true {
    background: var(--ok-subtle);
    color: var(--ok);
    border-color: var(--ok);
  }
  .badge-false {
    background: var(--bg-sunken);
    color: var(--fg-muted);
    border-color: var(--border-strong);
  }
  .badge-conditional {
    background: var(--warn-subtle);
    color: var(--warn);
    border-color: var(--warn);
  }
  .badge-unknown {
    background: var(--bg-sunken);
    color: var(--fg-subtle);
    border-color: var(--border);
    border-style: dashed;
  }
  .caveat {
    font-size: var(--text-sm);
    border-left: 4px solid var(--warn);
    background: var(--warn-subtle);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    margin-block: var(--space-3);
  }
  .evidence {
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    background: var(--bg-elevated);
  }
  .evidence summary {
    cursor: pointer;
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .evidence p {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .no-evidence,
  .guarantee-missing {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    border-left: 3px solid var(--border-strong);
    padding-left: var(--space-3);
  }
  .guarantee-missing {
    color: var(--danger);
    border-left-color: var(--danger);
  }
</style>
