# --- 第三者リポジトリのローカル参照用クローン ---
# .references/ 配下は sync-reference-repos.sh が clone した第三者コードであり、
# 本リポジトリでは絶対に再配布しない（SOURCE_POLICY.md 参照）。
.references/

# --- 原論文 PDF ---
# PDF は再配布可否が確認できたもの以外コミットしない。
# 既定では全 PDF を無視し、redistribution.status: allowed と確認できたものだけ
# `git add -f` で明示的に追加する運用とする。
docs/papers/**/*.pdf

# --- 資料コーパス本体（Marker 変換物・抽出図・読解メモ）---
# 論文本文の変換物と、論文から抽出した図画像はリポジトリへ置かない。
# 再配布可否が論文ごとに異なり、public リポジトリでは判断を誤ると
# そのまま再配布になるため、まとめて非公開にする（SOURCE_POLICY.md 第 11・12 条）。
#
# ★ ローカルには残す。削除しないこと。サイト本文を書くときの照合に要る。
# ★ docs/sources/*.yaml は別物。ビルドが読むので必ずコミットする。
docs/papers/**/marker.md
docs/papers/**/metadata.yaml
docs/papers/**/marker_meta.json
docs/papers/**/images/
docs/papers/**/*_ja.md

# Marker の生出力一式（論文本文の変換物と抽出図がそのまま入っている）。
# docs/papers/<id>/marker.md の供給元なので、同じ理由で置かない。
docs/output/
docs/output2/

# --- Marker 変換の一時生成物 ---
docs/papers/**/.marker-tmp/
docs/papers/**/*.marker.log

# --- Marker へ渡すための PDF 一括 zip ---
# 中身は再配布不可の PDF を含むため絶対にコミットしない。
/pdfs-to-markdown.zip
/*.zip

# --- Node ---
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# --- OS / エディタ ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# --- 作業用 ---
/tmp/
*.tmp
.cache/

# --- Astro / Node（サイト実装フェーズ以降）---
node_modules/
dist/
.astro/
.output/
.vercel/
.netlify/

# Vitest / Playwright
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# 環境変数
.env
.env.production
.env.local
